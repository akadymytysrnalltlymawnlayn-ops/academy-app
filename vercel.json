{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/send-supervisor-reminders",
      "schedule": "* * * * *"
    }
  ]
}
